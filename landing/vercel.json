{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/public/website-leads",
      "destination": "https://creditonegocios-production.up.railway.app/api/public/website-leads"
    }
  ],
  "redirects": [
    {
      "source": "/brokers",
      "destination": "https://app.creditonegocios.com.mx/brokers",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "https://app.creditonegocios.com.mx/",
      "permanent": false
    }
  ]
}
